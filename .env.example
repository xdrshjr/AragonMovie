# FastAPI Backend Configuration
# Copy this file to .env and fill in your actual API keys

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_TITLE=AI Movie Agent API
API_VERSION=1.0.0

# ==================== LLM Service Configuration ====================
# Fast LLM (for prompt optimization)
FAST_LLM_API_KEY=sk-sp-YOUR_ALI_TOKEN_PLAN_KEY_HERE
FAST_LLM_API_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
FAST_LLM_MODEL=qwen3.8-max
ENABLE_PROMPT_OPTIMIZATION=true

# Judge LLM (for image quality scoring)
JUDGE_LLM_API_KEY=sk-sp-YOUR_ALI_TOKEN_PLAN_KEY_HERE
JUDGE_LLM_API_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
JUDGE_LLM_MODEL=qwen3.8-max
ENABLE_CHARACTER_CONSISTENCY_JUDGE=true

# ==================== Image Service Configuration ====================
# Default image service: doubao, nano_banana, or midjourney
IMAGE_SERVICE_TYPE=ali_token_plan

# Doubao (豆包) Image Service
# placeholder only - replace with your real Ark key (never a real credential)
DOUBAO_API_KEY=your_doubao_ark_api_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com
DOUBAO_ENDPOINT=/api/v3/images/generations
DOUBAO_MODEL=doubao-seedream-4-5-251128
DOUBAO_WATERMARK=false

# Nano Banana Pro Image Service
# placeholder only - replace with your real key
NANO_BANANA_API_KEY=your_nano_banana_api_key_here
NANO_BANANA_BASE_URL=https://nanoapi.poloai.top
NANO_BANANA_ENDPOINT=/v1/images/generations
NANO_BANANA_MODEL=gemini-3-pro-image-preview

# Midjourney Image Service
MIDJOURNEY_API_KEY=your_midjourney_api_key_here
MIDJOURNEY_BASE_URL=https://api.kuai.host
MIDJOURNEY_BOT_TYPE=MID_JOURNEY
MIDJOURNEY_POLL_INTERVAL=3.0
MIDJOURNEY_MAX_POLL_ATTEMPTS=100
MIDJOURNEY_AUTO_UPSCALE=false
MIDJOURNEY_UPSCALE_INDEX=1

# ==================== Video Service Configuration ====================
# Video service type: veo3 or sora2
VIDEO_SERVICE_TYPE=ali_token_plan

# Veo3 Video Generation Service
VEO3_API_KEY=sk-YOUR_VEO3_API_KEY_HERE
VEO3_BASE_URL=https://api.kuai.host
VEO3_ENDPOINT=/v1/videos
VEO3_MODEL=veo_3_1
VEO3_SKIP_UPLOAD=true

# Sora2 Video Generation Service
SORA2_API_KEY=sk-YOUR_SORA2_API_KEY_HERE
SORA2_BASE_URL=https://api.kuai.host
SORA2_ENDPOINT=/v1/videos
SORA2_MODEL=sora-2
SORA2_DEFAULT_SIZE=1280x720
SORA2_DEFAULT_DURATION=8
SORA2_DEFAULT_STYLE=
SORA2_WATERMARK=false
SORA2_PRIVATE=false

# Video Generation Retry Configuration
VIDEO_GENERATION_MAX_RETRIES=3
VIDEO_GENERATION_RETRY_DELAY=5.0
VIDEO_GENERATION_RETRY_BACKOFF=2.0

# ==================== Task Management ====================
# Storage backend: memory or redis
TASK_STORAGE_BACKEND=memory
# Redis URL (only needed if TASK_STORAGE_BACKEND=redis)
REDIS_URL=redis://localhost:6379
# Task retention period in hours
TASK_RETENTION_HOURS=24
# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=10
# Cancel a running task when no client polled its status for this long
# (closed tab / dead browser). 0 disables the watchdog.
TASK_IDLE_TIMEOUT_SECONDS=900
TASK_IDLE_SWEEP_INTERVAL_SECONDS=30
# Delete backend/temp_projects/workflow_* directories older than this (hours)
TEMP_PROJECT_RETENTION_HOURS=12

# ==================== Concurrency Configuration ====================
IMAGE_MAX_CONCURRENT=3
VIDEO_MAX_CONCURRENT=2
# Worker threads kept for blocking media work (moviepy / ffmpeg composition).
# It runs outside the asyncio event loop so task-status polling keeps
# responding while the final video is being composed.
MEDIA_EXECUTOR_WORKERS=2

# ==================== Logging Configuration ====================
LOG_DIR=./logs
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# ==================== TTS (Voice) Service Configuration ====================
# IMPORTANT: the Ali Token Plan gateway lists qwen-audio-3.0-tts-plus but has NO
# one-shot HTTP synthesis route (/audio/speech -> 400 InvalidParameter "url
# error"; only the realtime model answers, over WebSocket). Pick a working
# transport below. With the Token Plan key alone the pipeline logs why speech
# was skipped and the video stays silent - it never pretends to have audio.
#
#   auto              -> DashScope host / Token Plan host use the native route,
#                        any other host uses /audio/speech
#   openai_compatible -> POST {TTS_BASE_URL}/audio/speech
#   dashscope_native  -> POST {TTS_NATIVE_BASE_URL}/api/v1/services/aigc/
#                        multimodal-generation/generation (qwen-tts / cosyvoice-v2)
ENABLE_TTS=true
TTS_PROVIDER=auto
TTS_API_KEY=sk-sp-YOUR_ALI_TOKEN_PLAN_KEY_HERE
TTS_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TTS_MODEL=qwen-audio-3.0-tts-plus
TTS_DEFAULT_VOICE=Cherry
TTS_DEFAULT_FORMAT=mp3
TTS_DEFAULT_SPEED=1.0
# DashScope native synthesis. TTS_NATIVE_API_KEY must be a DashScope key:
# the Token Plan key is not valid on dashscope.aliyuncs.com, so reusing it only
# produces a 401. When it is empty the pipeline refuses to fall back silently -
# it logs why speech was skipped instead of shipping a silent video.
TTS_NATIVE_BASE_URL=https://dashscope.aliyuncs.com
# REQUIRED for the native route when TTS_BASE_URL is NOT dashscope.aliyuncs.com:
# the Token Plan key is rejected by dashscope, so TTS_API_KEY is only reused as
# the native key when TTS_BASE_URL itself points at dashscope.aliyuncs.com.
TTS_NATIVE_API_KEY=
TTS_NATIVE_MODEL=qwen-tts
TTS_NATIVE_VOICE=Cherry
# Max concurrent narration requests per video (1-10)
TTS_MAX_CONCURRENT=3

# ==================== Agent Assist Configuration ====================
# Agent-assisted setup powered by AragonAgent (https://github.com/xdrshjr/AragonAgent)
# Install: npm i -g @aragon-agent/cli  (Node >= 18)
AGENT_ENABLED=false
# Agent LLM provider: openai (incl. any OpenAI-compatible endpoint), anthropic, google
AGENT_PROVIDER=openai
AGENT_API_KEY=your_agent_api_key_here
# Base URL for OpenAI-compatible endpoints (e.g. https://api.deepseek.com/v1); empty for official APIs
AGENT_BASE_URL=
AGENT_MODEL=gpt-4o
AGENT_MAX_TURNS=20
AGENT_TIMEOUT_SECONDS=300
# Path to the aragon CLI executable (default: aragon on PATH)
ARAGON_CLI_PATH=aragon

# ==================== Optional Features ====================
ENABLE_IMAGE_TO_IMAGE=true
ENABLE_SMART_DURATION=true
ENABLE_CHARACTER_REFERENCES=true


# ==================== Ali Token Plan (Ali Coding Plan) ====================
# OpenAI-compatible gateway; one key covers text/voice/image/video models
ALI_TOKEN_PLAN_API_KEY=sk-sp-YOUR_ALI_TOKEN_PLAN_KEY_HERE
ALI_TOKEN_PLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Image generation (wan2.7-image-pro)
ALI_IMAGE_ENDPOINT=/api/v1/services/aigc/multimodal-generation/generation
ALI_IMAGE_MODEL=wan2.7-image-pro
# Video generation (happyhorse-1.1 family: i2v=image-to-video, t2v=text-to-video, r2v=reference-to-video)
ALI_VIDEO_ENDPOINT=/api/v1/services/aigc/video-generation/video-synthesis
ALI_VIDEO_MODEL=happyhorse-1.1-i2v
ALI_VIDEO_T2V_MODEL=happyhorse-1.1-t2v
ALI_VIDEO_R2V_MODEL=happyhorse-1.1-r2v
ALI_VIDEO_DEFAULT_SIZE=1280x720
ALI_VIDEO_DEFAULT_DURATION=5
# Request the watermarked variant. The gateway defaults to the
# "..._refiner_watermark.mp4" file; false (default) asks for the clean one via
# parameters.watermark.
ALI_VIDEO_WATERMARK=false
