# FastAPI Backend Configuration
# Copy this file to .env and fill in your actual API keys

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_TITLE=AI Movie Agent API
API_VERSION=1.0.0

# ==================== LLM Service Configuration ====================
# Fast LLM (for prompt optimization)
FAST_LLM_API_KEY=sk-a5f209d824d54b6883fbc397fassdasd
FAST_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAST_LLM_MODEL=qwen-max-latest
ENABLE_PROMPT_OPTIMIZATION=true

# Judge LLM (for image quality scoring)
JUDGE_LLM_API_KEY=0fe6efc8-43fb-49be-a358-bdadasdasd
JUDGE_LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3
JUDGE_LLM_MODEL=doubao-seed-1-6-251015
ENABLE_CHARACTER_CONSISTENCY_JUDGE=true

# ==================== Image Service Configuration ====================
# Default image service: doubao, nano_banana, or midjourney
IMAGE_SERVICE_TYPE=doubao

# Doubao (豆包) Image Service
DOUBAO_API_KEY=0fe6efc8-43fb-49be-a358-bdaasdasd
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com
DOUBAO_ENDPOINT=/api/v3/images/generations
DOUBAO_MODEL=doubao-seedream-4-5-251128
DOUBAO_WATERMARK=false

# Nano Banana Pro Image Service
NANO_BANANA_API_KEY=sk-Zb5pnfIbQJQzRXjSJ1gR1rXsqVb6yvEG3rByasdasd
NANO_BANANA_BASE_URL=https://nanoapi.poloai.top
NANO_BANANA_ENDPOINT=/v1/images/generations
NANO_BANANA_MODEL=gemini-3-pro-image-preview

# Midjourney Image Service
MIDJOURNEY_API_KEY=your_midjourney_api_key_here
MIDJOURNEY_BASE_URL=https://api.kuai.host
MIDJOURNEY_BOT_TYPE=MID_JOURNEY
MIDJOURNEY_POLL_INTERVAL=3.0
MIDJOURNEY_MAX_POLL_ATTEMPTS=100
MIDJOURNEY_AUTO_UPSCALE=false
MIDJOURNEY_UPSCALE_INDEX=1

# ==================== Video Service Configuration ====================
# Video service type: veo3 or sora2
VIDEO_SERVICE_TYPE=veo3

# Veo3 Video Generation Service
VEO3_API_KEY=sk-YOUR_VEO3_API_KEY_HERE
VEO3_BASE_URL=https://api.kuai.host
VEO3_ENDPOINT=/v1/videos
VEO3_MODEL=veo_3_1
VEO3_SKIP_UPLOAD=true

# Sora2 Video Generation Service
SORA2_API_KEY=sk-YOUR_SORA2_API_KEY_HERE
SORA2_BASE_URL=https://api.kuai.host
SORA2_ENDPOINT=/v1/videos
SORA2_MODEL=sora-2
SORA2_DEFAULT_SIZE=1280x720
SORA2_DEFAULT_DURATION=8
SORA2_DEFAULT_STYLE=
SORA2_WATERMARK=false
SORA2_PRIVATE=false

# Video Generation Retry Configuration
VIDEO_GENERATION_MAX_RETRIES=3
VIDEO_GENERATION_RETRY_DELAY=5.0
VIDEO_GENERATION_RETRY_BACKOFF=2.0

# ==================== Task Management ====================
# Storage backend: memory or redis
TASK_STORAGE_BACKEND=memory
# Redis URL (only needed if TASK_STORAGE_BACKEND=redis)
REDIS_URL=redis://localhost:6379
# Task retention period in hours
TASK_RETENTION_HOURS=24
# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=10

# ==================== Concurrency Configuration ====================
IMAGE_MAX_CONCURRENT=3
VIDEO_MAX_CONCURRENT=2

# ==================== Logging Configuration ====================
LOG_DIR=./logs
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# ==================== TTS (Voice) Service Configuration ====================
# OpenAI-compatible /audio/speech endpoint (works with compatible gateways too)
ENABLE_TTS=false
TTS_API_KEY=your_tts_api_key_here
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_DEFAULT_VOICE=alloy
TTS_DEFAULT_FORMAT=mp3
TTS_DEFAULT_SPEED=1.0

# ==================== Agent Assist Configuration ====================
# Agent-assisted setup powered by AragonAgent (https://github.com/xdrshjr/AragonAgent)
# Install: npm i -g @aragon-agent/cli  (Node >= 18)
AGENT_ENABLED=false
# Agent LLM provider: openai (incl. any OpenAI-compatible endpoint), anthropic, google
AGENT_PROVIDER=openai
AGENT_API_KEY=your_agent_api_key_here
# Base URL for OpenAI-compatible endpoints (e.g. https://api.deepseek.com/v1); empty for official APIs
AGENT_BASE_URL=
AGENT_MODEL=gpt-4o
AGENT_MAX_TURNS=20
AGENT_TIMEOUT_SECONDS=300
# Path to the aragon CLI executable (default: aragon on PATH)
ARAGON_CLI_PATH=aragon

# ==================== Optional Features ====================
ENABLE_IMAGE_TO_IMAGE=true
ENABLE_SMART_DURATION=true
ENABLE_CHARACTER_REFERENCES=true

